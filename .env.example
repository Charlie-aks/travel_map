# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# PostgreSQL (Neon, Supabase hoặc Postgres local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth — tạo secret bằng: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Đăng nhập Google (tuỳ chọn)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chatbot AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Lưu ảnh upload trên Vercel Blob (không đặt → ảnh lưu vào public/uploads khi chạy local)
BLOB_READ_WRITE_TOKEN=""

# Google Analytics (tuỳ chọn)
NEXT_PUBLIC_GA_ID=""

# Tài khoản demo hiển thị trên trang đăng nhập — PHẢI là tài khoản role DEMO (chỉ xem).
# Để trống thì không hiển thị gợi ý demo.
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASSWORD=""
